---
import ShowcaseLayout from "../layouts/showcase.astro"
import { Navbar } from "../components/navbar"
import { Hero } from "../components/hero"
import { Features } from "../components/features"
import { WebSection } from "../components/web-section"
import { DesktopSection } from "../components/desktop-section"
import { CtaSection } from "../components/cta-section"
---

<ShowcaseLayout>
  <Navbar client:load />
  <main>
    <Hero client:load />
    <Features client:visible />
    <WebSection client:visible />
    <DesktopSection client:visible />
    <CtaSection client:visible />
  </main>
  <footer class="border-t border-white/5 py-8">
    <div
      class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-6 sm:flex-row"
    >
      <div class="flex items-center gap-3">
        <div
          class="flex h-6 w-6 items-center justify-center bg-brand text-[10px] font-bold text-brand-foreground"
        >
          t.
        </div>
        <span class="text-xs text-muted-foreground">typsmthng</span>
      </div>
      <div class="flex gap-6">
        <a
          href="https://github.com/aaditagrawal/typsmsite"
          class="text-xs text-muted-foreground transition-colors hover:text-foreground"
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub
        </a>
        <a
          href="https://typsmthng.coolstuff.work"
          class="text-xs text-muted-foreground transition-colors hover:text-foreground"
        >
          Web App
        </a>
      </div>
    </div>
  </footer>
</ShowcaseLayout>
