---
import * as stylex from "@stylexjs/stylex"
import { styles } from "../styles/site.stylex"
import ShowcaseLayout from "../layouts/showcase.astro"
import { Navbar } from "../components/navbar"
import { Hero } from "../components/hero"
import { Features } from "../components/features"
import { WebSection } from "../components/web-section"
import { DesktopSection } from "../components/desktop-section"
import { CtaSection } from "../components/cta-section"
---

<ShowcaseLayout>
  <Navbar client:load />
  <main>
    <Hero client:load />
    <Features client:visible />
    <WebSection client:visible />
    <DesktopSection client:visible />
    <CtaSection client:visible />
  </main>
  <footer class={stylex.props(styles.footer).className}>
    <div class={stylex.props(styles.footerContent).className}>
      <div class={stylex.props(styles.footerLogo).className}>
        <div class={stylex.props(styles.footerIcon).className}>t.</div>
        <span class={stylex.props(styles.footerTitle).className}>typsmthng</span
        >
      </div>
      <div class={stylex.props(styles.footerLinks).className}>
        <a
          href="https://github.com/aaditagrawal/typsmsite"
          class={stylex.props(styles.footerSource).className}
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub
        </a>
        <a
          href="https://typsmthng.coolstuff.work"
          class={stylex.props(styles.footerWeb).className}
        >
          Web App
        </a>
      </div>
    </div>
  </footer>
</ShowcaseLayout>
